# Copy to .env and replace every placeholder before any shared or production use.
APP_ENV=development
APP_NAME=IMPERIONX OS
DATABASE_URL=postgresql+psycopg://imperionx:replace-this-password@db:5432/imperionx
POSTGRES_USER=imperionx
POSTGRES_PASSWORD=replace-this-password
POSTGRES_DB=imperionx
PUBLIC_BASE_URL=http://localhost:3000

# Generate a unique Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Generate a random value of at least 32 characters for this setting.
PUBLIC_RATE_LIMIT_HMAC_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

AI_PROVIDER=safe-demo
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Outbound webhooks are opt-in. Keep false for the API; enable only in the
# separately deployed webhook-worker service after network/security review.
WEBHOOK_DELIVERY_ENABLED=false
WEBHOOK_WORKER_ENABLED=false

# SQLAlchemy connection pool sizing; account for API replicas and worker replicas.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
